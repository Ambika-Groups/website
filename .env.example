# Where the enquiry form posts (docs/shared/enquiry-form-contract.md, version 2.1).
# Stage 1 (now): leave empty to use Web3Forms (https://api.web3forms.com/submit).
# Stage 2 (CRM Phase 3): the URL of the CRM's submitEnquiry function. access_key is then not sent.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Web3Forms access key (stage 1 only). Public by design (it ships in the browser bundle).
# Restrict it to the site's domain in the Web3Forms dashboard if the plan allows.
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Canonical site origin, used for metadata, JSON-LD, sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com
