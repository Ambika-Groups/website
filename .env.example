# Where the enquiry form posts (docs/shared/enquiry-form-contract.md, version 3).
# The URL of the website's own submitEnquiry function, e.g.
#   https://asia-south1-YOUR-PROJECT.cloudfunctions.net/submitEnquiry
# Leave empty to fall back to Web3Forms (https://api.web3forms.com/submit). access_key is then sent.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# Web3Forms access key (fallback only). Public by design (it ships in the browser bundle).
# Restrict it to the site's domain in the Web3Forms dashboard if the plan allows.
NEXT_PUBLIC_WEB3FORMS_KEY=YOUR_WEB3FORMS_ACCESS_KEY

# Canonical site origin, used for metadata, JSON-LD, sitemap. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Website Firebase project (its own project, not the CRM's). Firebase web settings are public by design: they
# identify the project; the security rules (firestore.rules, storage.rules) are what protect the data.
# Leave NEXT_PUBLIC_FIREBASE_PROJECT_ID empty for demo mode: /admin then runs on sample data in the browser,
# and the build uses the content files and the last saved snapshot (src/generated/cms-*.json).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
